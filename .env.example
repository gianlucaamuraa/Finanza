# Connessione Postgres. Con Supabase usa la stringa "Transaction pooler" (porta 6543)
DATABASE_URL=postgres://utente:password@host:5432/database
# Password per accedere all'app
APP_PASSWORD=scegli-una-password-robusta
# Segreto per firmare la sessione (genera con: openssl rand -hex 32)
AUTH_SECRET=
